{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Standard JSON Resume Schema v1.0.0 (Kitchen Sink)",
  "description": "A comprehensive JSON schema for a resume, implementing all fields from the official v1.0.0 'Kitchen Sink' example. This schema is designed for maximum data representation and flexibility.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri",
      "description": "Link to the official JSON Resume schema definition."
    },
    "basics": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "label": { "type": "string", "description": "Professional headline, e.g., 'Full Stack Systems Architect'." },
        "image": { "type": "string", "format": "uri", "description": "URL to a profile photograph." },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "url": { "type": "string", "format": "uri", "description": "Personal website or portfolio URL." },
        "summary": { "type": "string", "description": "A 2-4 sentence professional biography." },
        "location": {
          "type": "object",
          "properties": {
            "address": { "type": "string" },
            "postalCode": { "type": "string" },
            "city": { "type": "string" },
            "countryCode": { "type": "string", "description": "ISO 3166-1 alpha-2 code." },
            "region": { "type": "string", "description": "State, province, or prefecture." }
          }
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "network": { "type": "string", "description": "e.g., 'GitHub', 'LinkedIn'." },
              "username": { "type": "string" },
              "url": { "type": "string", "format": "uri" }
            }
          }
        }
      },
      "required": ["name", "email"]
    },
    "work": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "description": "Company name." },
          "company": { "type": "string", "description": "Company name (Legacy)." },
          "location": { "type": "string", "description": "Physical location of the office." },
          "description": { "type": "string", "description": "A brief description of the company." },
          "position": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "startDate": { "type": "string", "description": "ISO 8601 format: YYYY-MM-DD, YYYY-MM, or YYYY." },
          "endDate": { "type": "string", "description": "ISO 8601 format. Empty or omitted for current role." },
          "summary": { "type": "string", "description": "Narrative overview of responsibilities." },
          "highlights": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "volunteer": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "organization": { "type": "string" },
          "position": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "startDate": { "type": "string" },
          "endDate": { "type": "string" },
          "summary": { "type": "string" },
          "highlights": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "institution": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "area": { "type": "string", "description": "Major or field of study." },
          "studyType": { "type": "string", "description": "Degree type, e.g., 'Bachelor'." },
          "startDate": { "type": "string" },
          "endDate": { "type": "string" },
          "score": { "type": "string", "description": "GPA or classification, e.g., '3.8/4.0'." },
          "courses": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "awards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "date": { "type": "string" },
          "awarder": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    },
    "certificates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "date": { "type": "string" },
          "issuer": { "type": "string" },
          "url": { "type": "string", "format": "uri", "description": "Verification link." }
        }
      }
    },
    "publications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "publisher": { "type": "string" },
          "releaseDate": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "summary": { "type": "string", "description": "The abstract." }
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "description": "Skill category, e.g., 'Web Development'." },
          "level": { "type": "string", "description": "e.g., 'Advanced'." },
          "keywords": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "language": { "type": "string" },
          "fluency": { "type": "string", "description": "e.g., 'Native', 'Fluent'." }
        }
      }
    },
    "interests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "keywords": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "reference": { "type": "string", "description": "The reference text." }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "highlights": { "type": "array", "items": { "type": "string" } },
          "keywords": { "type": "array", "items": { "type": "string" } },
          "startDate": { "type": "string" },
          "endDate": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "roles": { "type": "array", "items": { "type": "string" } },
          "entity": { "type": "string", "description": "Affiliated company or organization." },
          "type": { "type": "string", "description": "e.g., 'Application', 'Library'." }
        }
      }
    },
    "meta": {
      "type": "object",
      "description": "Metadata about the resume file itself.",
      "properties": {
        "canonical": { "type": "string", "format": "uri", "description": "The source-of-truth URL for this resume." },
        "version": { "type": "string", "description": "A personal version string, e.g., 'v1.0.1'." },
        "lastModified": { "type": "string", "format": "date-time" },
        "skipValidation": { "type": "boolean", "description": "If true, allows custom fields to pass validation in some tools." }
      }
    }
  }
}
